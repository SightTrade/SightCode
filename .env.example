# ---- SIGHT server-side environment configuration ----
# Copy to .env.local and fill in values. NEVER expose secrets to the client
# (anything without NEXT_PUBLIC_ stays server-side only).
# Full audit: docs/API_KEYS_AUDIT.md · Setup guide: docs/API_KEYS_SETUP.md
# The app runs with NO keys (public defaults) — every entry below upgrades an
# already-working integration.
#
# ============================ PRODUCTION DEPLOYMENT ============================
# Target architecture: single Linux VPS · Node.js 20+ · PM2 (`ecosystem.config.js`)
# · Nginx HTTPS reverse proxy (`deploy/nginx-sight.conf`) · app on 127.0.0.1:3210.
#
# WHERE VARIABLES ARE ENTERED:
#   1. On the VPS, copy this file to /opt/sight/.env.local and fill in values.
#      Next.js loads .env.local automatically in production — do NOT put secret
#      values into the PM2 ecosystem file (`pm2 env` displays them to any
#      shell user on the box; the .env.local file is root/owner-readable only).
#   2. NEVER commit this file with real values (.gitignore already excludes
#      .env*). NEVER prefix a secret with NEXT_PUBLIC_ (those ship to browsers).
#
# REQUIRED FOR PRODUCTION (the app refuses degraded features without them):
#   SOLANA_RPC_URL        — Helius URL with embedded key (recommended; the same
#                           key powers the Enhanced transaction-decoding API)
#   NEXT_PUBLIC_SOLANA_RPC— public keyless Solana endpoint (browser broadcast)
#   JUPITER_API_KEY       — Jupiter swap API key
#   ETHEREUM_RPC_URL      — Alchemy Ethereum HTTPS URL (key embedded)
#   BSC_RPC_URL           — Alchemy BNB Chain HTTPS URL (key embedded)
#   BASE_RPC_URL          — Alchemy Base HTTPS URL (key embedded)
# OPTIONAL (defaults are verified working — set only to override):
#   HELIUS_API_KEY · ETHERSCAN_API_KEY · BSCSCAN_API_KEY · BASESCAN_API_KEY ·
#   JUPITER_BASE · DEXSCREENER_BASE · GECKOTERMINAL_BASE · PUMPPORTAL_WS_URL
# NO database is required (no DATABASE_URL — the app is stateless server-side).
# ==============================================================================


# ---- Solana RPC ----
# Public endpoint is rate-limited. For reliable risk checks (mint authority,
# top holders, tx confirmation) use a paid provider such as Helius
# (https://dashboard.helius.dev — free plan: 1M credits/mo):
#   https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# OPTIONAL — public default works and has been verified.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Reserved (NOT read by the current code) ----
# Named by the Smart Money UI as the future enabler of decoded Solana wallet
# activity. Setting it today has no effect; implement the feature first.
# HELIUS_API_KEY=

# ---- Optional API keys (free tiers available; app works without them) ----
# Jupiter (api.jup.ag): keyless access at 0.5 RPS; a free key raises limits.
#   https://developers.jup.ag/portal
# OPTIONAL — verified working keyless.
JUPITER_API_KEY=

# ---- EVM RPC endpoints (Alchemy or equivalent) ----
# Create ONE Alchemy app per network (https://dashboard.alchemy.com) and paste
# each network's HTTPS URL into its own variable — never share one network's
# URL across chains. Example: https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# Read dynamically per chain (process.env[chain.rpcEnvKey]).
# OPTIONAL — public PublicNode defaults are verified working:
#   ethereum-rpc.publicnode.com · bsc-rpc.publicnode.com · base-rpc.publicnode.com
# 🔒 Secrets when the provider embeds a key in the URL — server-side only.
ETHEREUM_RPC_URL=
BSC_RPC_URL=
BASE_RPC_URL=

# ---- Browser-side EVM RPC — intentionally absent ----
# Browser EVM calls are routed through the chain-aware server proxy
# (/api/rpc/[chain]), which resolves each network to the server-side
# ETHEREUM/BSC/BASE_RPC_URL above. This keeps provider credentials embedded in
# Alchemy-style URLs server-side and guarantees each chain's browser requests
# reach the correct network. Do not add a shared NEXT_PUBLIC EVM URL: one
# endpoint cannot serve multiple EVM chains safely.

# ---- Robinhood Chain (BLOCKED — do not configure yet) ----
# The chain is registered but disabled: no official RPC / chain ID / market-data
# source has been verified. Do not point this at an unverified community
# endpoint (wrong chain ID = wrong-network signing risk). The app honestly
# reports every Robinhood feature as unavailable until then.
# ROBINHOOD_RPC_URL=

# ---- Block explorer API keys (Etherscan family) ----
# IMPORTANT: the current code only checks whether these exist (to shape the
# token risk report). No explorer API is called. They become actionable only
# when the source-verification risk feature is implemented.
# OPTIONAL — free tiers at etherscan.io/apis, bscscan.com/apis, basescan.org/apis
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
BASESCAN_API_KEY=

# ---- Discovery pipeline (verified 2026-10-26, live) ----
# PumpPortal (Solana): free methods subscribeNewToken + subscribeMigration
# need NO API key (docs: pumpportal.fun/data-api/real-time/). One connection
# per client; metered trade streams (subscribeTokenTrade/subscribeAccountTrade)
# cost 0.01 SOL per 10k events and are intentionally NOT used.
# Optional endpoint override (default: wss://pumpportal.fun/api/data):
# PUMPPORTAL_WS_URL=

# DexScreener: keyless public API used for pair/price/liquidity/volume
# enrichment of new pools (GET /tokens/v1/{chain}/{addresses}, ≤30 per
# request, 300 req/min limit). No configuration required; optional base
# override: DEXSCREENER_BASE=https://api.dexscreener.com

# GeckoTerminal: keyless free API (~30 req/min shared budget) powers the
# per-network new-pools pollers. Optional base override:
# GECKOTERMINAL_BASE=https://api.geckoterminal.com
DEXSCREENER_BASE=https://api.dexscreener.com
GECKOTERMINAL_BASE=https://api.geckoterminal.com
JUPITER_BASE=https://api.jup.ag

# ---- Optional client-side RPC overrides (PUBLIC CONFIG — visible in the browser) ----
# Used for embedded-wallet Solana transaction broadcasting. EVM browser calls
# do not use a client-side variable — they go through the chain-aware server
# proxy (/api/rpc/[chain]) described above.
# Never put a secret-bearing URL here: NEXT_PUBLIC_* values ship to every visitor.
NEXT_PUBLIC_SOLANA_RPC=

# ---- Official SIGHT token mint (PUBLIC CONFIG — visible in the browser) ----
# Placeholder until the official SIGHT token mint is announced. While this
# placeholder is configured the header shows "SIGHT TOKEN — COMING SOON" and
# never treats the placeholder as a tradeable token (no price, balance, or
# swap requests). Replace the value with the real official mint when
# announced — NEXT_PUBLIC_* values are embedded into browser assets at BUILD
# time, so changing it requires rebuilding and redeploying the frontend.
NEXT_PUBLIC_SIGHT_TOKEN_MINT=1nc1nerator11111111111111111111111111111111

